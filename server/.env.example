# Copy to .env and fill in. NEVER commit .env
YAHBS_ENV=production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Use PostgreSQL in production: postgresql+psycopg://user:pass@localhost/yahbs
DATABASE_URL=
# Set to 1 when served over HTTPS (it should always be)
FORCE_HTTPS=1
# Number of reverse proxies in front of the app (nginx = 1)
PROXY_HOPS=1
# Use Redis for rate limits when running several workers: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
MAX_UPLOAD_MB=512

# Email (needed for verification + password reset). Port 587 = STARTTLS.
REQUIRE_EMAIL_VERIFY=1
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=YAHBS <noreply@example.com>
PUBLIC_URL=https://store.example.com
